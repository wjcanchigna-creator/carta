<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Para mi amor ❤️</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <div class="card">
        <div class="heart">❤️</div>
        <h1 id="titulo">Una carta especial...</h1>
        <p id="mensaje">Dijiste que nunca habías recibido una carta de amor, así que decidí programarte una. ✨</p>
        
        <button id="btn-accion" onclick="siguientePaso()">Siguiente ➡️</button>

        <div id="opciones-finales" class="oculto">
            <button class="btn-final" onclick="respuesta('si')">¡Me encantó! 🥰</button>
            <button class="btn-final btn-secundario" onclick="respuesta('no')">Quiero la versión 2.0 🍫</button>
        </div>

        <p id="respuesta-texto" class="respuesta"></p>
    </div>

    <script>
        const pasos = [
            { titulo: "Una carta especial...", mensaje: "Dijiste que nunca habías recibido una carta de amor, así que decidí programarte una. ✨" },
            { titulo: "Hecha línea por línea", mensaje: "Porque algo tan bonito como lo que siento por ti no podía ir en un papel común. 💻❤️" },
            { titulo: "Gracias por todo", mensaje: "Gracias por ser mi compañera, mi risa favorita y mi lugar seguro todos los días." },
            { titulo: "Tengo una pregunta...", mensaje: "¿Qué te pareció tu primera carta de amor interactiva?" }
        ];

        let pasoActual = 0;

        function siguientePaso() {
            pasoActual++;
            if (pasoActual < pasos.length) {
                document.getElementById('titulo').innerText = pasos[pasoActual].titulo;
                document.getElementById('mensaje').innerText = pasos[pasoActual].mensaje;
                
                if (pasoActual === pasos.length - 1) {
                    document.getElementById('btn-accion').style.display = 'none';
                    document.getElementById('opciones-finales').classList.remove('oculto');
                }
            }
        }

        function respuesta(tipo) {
            const respTexto = document.getElementById('respuesta-texto');
            document.getElementById('opciones-finales').style.display = 'none';
            if (tipo === 'si') {
                respTexto.innerText = "¡Sabía que te sacaría una sonrisa! Te amo con todo mi corazón. 💖";
            } else {
                respTexto.innerText = "¡Prometo que la versión 2.0 vendrá con chocolates y tu cena favorita! 🍫🍷";
            }
        }
    </script>
</body>
</html>
